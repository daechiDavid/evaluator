# Copy this file to .env.local for local development. Never commit real secrets here.
# Required on the server. Never prefix secrets with NEXT_PUBLIC_.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional shared access gate. Leave both empty for local UI-only development.
APP_ACCESS_CODE_HASH=
APP_SESSION_SECRET=
